              },
              {
                "group": "Earn routing",
                "icon": "chart-line",
                "root": "earn/smart-account",
                "expanded": false,
                "pages": [
                  "earn/same-mint-optimization",
                  "earn/orchestrator",
                  "earn/trust-model"
                ]
