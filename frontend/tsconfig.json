{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@loyal/actions": ["../packages/loyal-actions/src/index.ts"],
      "@loyal/actions/constants": [
        "../packages/loyal-actions/src/constants.ts"
      ],
      "@loyal/actions/types": ["../packages/loyal-actions/src/types.ts"],
      "@loyal-labs/shared": ["../packages/shared/src/index.ts"],
      "@loyal-labs/shared/analytics": ["../packages/shared/src/analytics.ts"],
      "@loyal-labs/shared/analytics-server": [
        "../packages/shared/src/analytics-server.ts"
      ],
      "@loyal-labs/solana-instruction-decoder": [
        "../packages/solana-instruction-decoder/src/index.ts"
      ],
      "@loyal-labs/solana-rpc": ["../packages/solana-rpc/src/index.ts"],
      "@loyal-labs/solana-wallet": ["../packages/solana-wallet/src/index.ts"]
    },
    "strictNullChecks": true
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
