HOST=127.0.0.1
PORT=3000
CLICKSTACK_WEBHOOK_SECRET=replace-with-a-long-random-secret
TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
TELEGRAM_CHAT_ID=replace-with-telegram-chat-id
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/replace/me
COOLDOWN_SECONDS=3600
IDEMPOTENCY_TTL_SECONDS=86400
MAX_CACHE_ENTRIES=10000
MAX_BODY_BYTES=65536
ALERT_COLUMNS=Timestamp,ServiceName,SeverityText,Body
CARDINALITY_COLUMNS=
DIGEST_ENABLED=true
DIGEST_SILENT=true
ESCALATION_MULTIPLIER=10
RESTART_GRACE_SECONDS=120
SWEEP_INTERVAL_SECONDS=60
STATE_FILE=
TRACE_LOGS=false
