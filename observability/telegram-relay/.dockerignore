# Denylist rather than a `*` allowlist: an allowlist that fails to re-include
# `src/` builds a valid image with no application code in it.
node_modules
.env
.env.*
!.env.example
src/*.test.ts
scripts
README.md
# `bun.lock` is deliberately NOT ignored: the image installs the Neon driver
# with `--frozen-lockfile`, which needs it in the build context.
