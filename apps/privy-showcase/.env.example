# Public values. RPC transport is frozen in code to the demo's keyless endpoint.
NEXT_PUBLIC_PRIVY_APP_ID=

# Server-only. Keep this in 1Password; never expose it with NEXT_PUBLIC_.
SMART_ACCOUNT_SPONSOR_PK=
SMART_ACCOUNT_SPONSOR_PUBKEY=
EARN_POLICY_SPONSOR_PK=

# Optional, server-only: a keyed mainnet RPC for the sponsor's own reads and
# re-derivation, so the server does not compete with browsers for the shared
# keyless endpoint's rate limit. The key never reaches the browser.
DEMO_SERVER_RPC_URL=

# Optional, server-only: signs the demo's wallet session and challenge tokens.
# Falls back to EARN_POLICY_SPONSOR_PK when unset, so no Vercel change is needed.
# Rotating it invalidates every open demo session.
DEMO_SESSION_SECRET=
