{
  "name": "loyal-web-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "bun run --cwd ../.. build:packages",
    "dev": "ALLOW_LOCAL_CAPTCHA_BYPASS=1 NEXT_PUBLIC_APP_ENVIRONMENT=local next dev --turbopack",
    "dev:1pass": "bun run dev:1pass:main",
    "dev:1pass:dev": "op run --env-file=../../.env.1password -- sh -c 'CAP_SECRET=\"${CAP_SECRET:-$(openssl rand -hex 32)}\" bun dev'",
    "dev:1pass:main": "op run --env-file=../../.env.mainnet.1password -- sh -c 'CAP_SECRET=\"${CAP_SECRET:-$(openssl rand -hex 32)}\" bun dev'",
    "generate-grpc": "buf generate src/lib/proto",
    "prebuild": "bun run --cwd ../.. build:packages",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "smart-accounts:reconcile": "bun run src/features/smart-accounts/server/run-reconciler.ts",
    "ultracite": "bunx ultracite check",
    "verify:earn-multi-mint-readiness": "bun --conditions=react-server scripts/verify-earn-multi-mint-readiness.ts",
    "verify:earn-multi-mint-server-followups": "bun --conditions=react-server scripts/verify-earn-multi-mint-server-followups.ts",
    "fix-lint": "next lint --fix",
    "verify:chunk-load-recovery": "bun scripts/verify-chunk-load-recovery.ts",
    "verify:observability": "bun scripts/verify-observability.ts",
    "commit": "cz",
    "knip": "bunx knip"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^1.0.24",
    "@ai-sdk/provider-utils": "^3.0.22",
