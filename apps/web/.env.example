NEXT_PUBLIC_APP_ENVIRONMENT=local
NEXT_PUBLIC_FLAGS_MANIFEST_URL=http://localhost:3001/api/flags/frontend-manifest
SOLANA_PRIVATE_KEY=
PHALA_API_KEY=
PHALA_MODEL_ID=
CAP_SECRET=
NEXT_PUBLIC_JUPITER_API_KEY=
NEXT_PUBLIC_SOLANA_ENV=devnet
SMART_ACCOUNT_SPONSOR_PK=
REALTIME_AUTH_SECRET=
REALTIME_EVENTS_URL=http://127.0.0.1:10000/events
SOLANA_MAINNET_RPC_URL=
SOLANA_MAINNET_WEBSOCKET_URL=
SOLANA_DEVNET_RPC_URL=
SOLANA_DEVNET_WEBSOCKET_URL=
# Server-side Autoswap enrollment rollout. Comma-separated canonical wallet
# addresses; blank means no new enrollment and "*" enables every wallet.
# Existing enrollments remain visible and manageable when a wallet is removed.
EARN_AUTOSWAP_ENABLED_WALLETS=
NEXT_PUBLIC_SKILLS_ENABLED=true
NEXT_PUBLIC_DEMO_RECIPE=false

# Cherry MiniApp launch verification (server-only; the origin excludes /app/cherry).
CHERRY_MINIAPP_ID=
CHERRY_MINIAPP_ORIGIN=

# Solana Week — Challenge Quest Completion API (backend-only; never NEXT_PUBLIC_).
# Master kill-switch (fail-safe OFF): quest completions are sent to Solana ONLY
# when this is exactly "true". Hidden for the dApp Store launch until the reveal;
# set to "true" to go live. See mobile/docs/quests-launch-toggle.md.
SOLANA_WEEK_QUESTS_ENABLED=
# Tester carve-out: while the kill-switch is off, still report completions for
# these wallets (comma-separated base58) so internal preview-build testers can
# verify quests end-to-end. Wallet-keyed, so it covers both quests.
SOLANA_WEEK_QUESTS_TESTER_WALLETS=
# Reporter no-ops until endpoint + key + the relevant quest id are set.
# Use production for now (Solana swaps the key at launch):
# https://publish.solanamobile.com/api/challenges/quest-completions
SOLANA_WEEK_QUESTS_COMPLETION_ENDPOINT=
SOLANA_WEEK_QUESTS_API_KEY=
# Optional: only if Solana requires request signing (base58/base64 Ed25519 key).
SOLANA_WEEK_QUESTS_SIGNING_KEY=
# Quest 1 "connect wallet and deposit in Earn" — tracked via the manual Earn deposit.
SOLANA_WEEK_QUEST_ID_EARN_DEPOSIT=
# Quest 2 "first Earn deposit via autodeposit" — tracked via the balance sweep.
SOLANA_WEEK_QUEST_ID_FIRST_AUTODEPOSIT=
# Optional lookback (hours) for the reconciliation cron's sweep backfill; default 168 (7d).
SOLANA_WEEK_SWEEP_LOOKBACK_HOURS=
# Bearer secret the autodeposit sweep worker uses to call /api/solana-week/sweep-notify.
SOLANA_WEEK_NOTIFY_SECRET=

# Mobile push bridge (ASK-1651): app deployment that owns the Expo push tokens.
# MOBILE_PUSH_API_SECRET must match the app's PUSH_DEBUG_SECRET. Unset = pushes off.
MOBILE_PUSH_API_BASE_URL=
MOBILE_PUSH_API_SECRET=

# Mixpanel cohort webhook (ASK-1651 P2/P3): Basic-auth password for
# /api/push/mixpanel-cohort (username is ignored). Unset = receiver rejects all.
MIXPANEL_COHORT_WEBHOOK_SECRET=

# Privy login (ASK-2263). Unset = legacy wallet-only SIWS sign-in.
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=
