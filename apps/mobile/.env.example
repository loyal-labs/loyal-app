EXPO_PUBLIC_API_BASE_URL=https://your-app.vercel.app
EXPO_PUBLIC_SOLANA_ENV=devnet
# Optional mainnet RPC override. Use a Helius Secure URL (host-authenticated,
# no api-key); never a keyed URL — anything EXPO_PUBLIC_ ships in the bundle.
EXPO_PUBLIC_SOLANA_MAINNET_RPC_URL=
# OneSignal dashboard > Settings > Keys & IDs. Init is skipped when unset.
EXPO_PUBLIC_ONESIGNAL_APP_ID=
