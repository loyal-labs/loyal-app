{
  "ignoreCommand": "git diff HEAD^ HEAD --quiet -- . ../packages ../sdk",
  "installCommand": "rm -rf node_modules && cd .. && bun install --frozen-lockfile",
  "buildCommand": "bun run build && bash scripts/upload-sourcemaps.sh",
  "crons": [
    {
      "path": "/api/cron/telegram-helper-cleanup",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/summaries",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/private-transfer-analytics",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/push-incoming-transfers",
      "schedule": "*/2 * * * *"
    },
    {
      "path": "/api/cron/push-shielded-transfers",
      "schedule": "1-59/2 * * * *"
    },
    {
      "path": "/api/cron/helius-webhook-resync",
      "schedule": "0 4 * * *"
    }
  ]
}
